# ThermalTrace Frontend Environment Configuration Template
# Copy this file to frontend/.env for local development

# 1. Backend API Base URL
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080

# 2. Public Supabase Configuration (Optional - Client Anon key only, NEVER Service Role Key)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Optional Map Tile / Satellite Imagery Provider Credentials (Browser-safe public keys)
VITE_THUNDERFOREST_API_KEY=your_optional_thunderforest_key_here
VITE_ARCGIS_API_KEY=your_optional_arcgis_key_here
